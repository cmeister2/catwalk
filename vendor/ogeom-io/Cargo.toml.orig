[package]
name = "ogeom-io"
description = "File formats: BREP, STL, STEP, IGES, glTF, DXF"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
homepage.workspace = true
readme.workspace = true
keywords.workspace = true
categories.workspace = true

# The published tarball carries only what it can run. These suites read the
# shared corpus under `tests/corpus/` at the repository root, which is outside
# every package and stays there: it is 4.9 MB of real exchange files, and
# copying it into each crate that reads it would ship it several times over.
# The repository still runs them, and `tools/check.sh` still gates on them.
exclude = [
    "tests/step_corpus.rs",
]

[dependencies]
ogeom-core.workspace = true
ogeom-math.workspace = true
ogeom-geom.workspace = true
ogeom-topo.workspace = true
ogeom-doc.workspace = true
# The STEP reader builds real topology as it reads, and computes exact
# pcurves for the edges it lands on faces; both live above the data layer.
ogeom-algo.workspace = true
ogeom-intersect.workspace = true
# A void's orientation is read off its meshed signed volume.
ogeom-mesh.workspace = true
# Constructive solids read as the booleans their trees name.
ogeom-bool.workspace = true

[dev-dependencies]
# The round trip is only worth testing against shapes something really built,
# so the tests reach for the builders. Nothing in `ogeom-algo` depends on `ogeom-io`,
# so this adds no cycle and nothing to the library's own dependencies.
ogeom-algo.workspace = true
approx.workspace = true
proptest.workspace = true

[lints]
workspace = true
