#usda 1.0
(upAxis = "Z"; metersPerUnit = 1)
def PointInstancer "Copies" {
    rel prototypes = [</Copies/Prototype>]
    int[] protoIndices = [0,0,0]
    point3f[] positions = [(-2,0,0),(0,0,0),(2,0,0)]
    float3[] scales = [(0.65,0.65,0.65),(0.8,0.8,0.8),(1,1,1)]
    def Sphere "Prototype" { double radius = 0.7 color3f[] primvars:displayColor = [(0.12,0.5,0.8)] }
}
def BasisCurves "Arc" {
    uniform token type = "cubic"
    uniform token basis = "bezier"
    uniform token wrap = "nonperiodic"
    int[] curveVertexCounts = [4]
    point3f[] points = [(-2,0,1),(-1,0,3),(1,0,3),(2,0,1)]
    color3f[] primvars:displayColor = [(0.9,0.3,0.1)]
}
