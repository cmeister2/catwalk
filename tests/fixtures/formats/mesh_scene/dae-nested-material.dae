    <library_geometries><geometry id="tetra"><mesh><source id="pos"><float_array id="pos-array" count="12">0 0 0 2 0 0 0 1.6 0 0.35 0.45 2.3</float_array><technique_common><accessor source="#pos-array" count="4" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source><vertices id="vertices"><input semantic="POSITION" source="#pos"/></vertices><triangles count="4" material="surface"><input semantic="VERTEX" source="#vertices" offset="0"/><p>0 2 1 0 1 3 1 2 3 2 0 3</p></triangles></mesh></geometry></library_geometries>
