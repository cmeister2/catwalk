# [Scene] ========== ========== ==========
WorldInfo {
  title "ProtoInstanceExample.x3d"
}
PROTO NewShape [
  field        SFNode       InitialAppearance     Appearance {
      material Material {
        diffuseColor 1 0 0
      }
    }
  field        SFFloat	 newHeight 3
  field        SFFloat	 newRadius 0.5
] {
  DEF ContainedShape Shape {
          appearance IS InitialAppearance
    geometry DEF ContainedCylinder Cylinder {
              height IS newHeight
        radius IS newRadius
    }
  }
}
Billboard {
  children [
       NewShape {
        newHeight  3
        newRadius  4
        InitialAppearance            Appearance {
            material DEF CylinderMaterial Material {
              diffuseColor 0 1 0
            }
          }
      }
  ]
}
